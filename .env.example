# Copy this file to .env and replace the placeholder locally.
# Never commit your real LocalStack authentication token.
LOCALSTACK_AUTH_TOKEN=replace_with_your_localstack_token

# Base64-encoded HMAC secret for the local Auth service and CDK task definition.
# Generate a unique value for your environment; never commit the real value.
JWT_SECRET=replace_with_a_base64_encoded_secret

# Local AWS development credentials (not production credentials)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
